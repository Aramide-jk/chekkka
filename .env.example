NODE_ENV=development
PORT=3000

# Public
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=chekka
REDIS_URI=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_TOKEN_SECRET=replace_me_with_a_long_random_secret_string
JWT_REFRESH_TOKEN_SECRET=replace_me_with_a_long_random_secret_string
COOKIE_DOMAIN=

# AWS S3 (leave empty to use mock:// URLs for local dev)
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
CLOUDFRONT_CDN_URL=

# Paystack (leave empty to use the mock payment flow)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Set to 1 in e2e to bypass rate limiting
DISABLE_RATE_LIMIT=

# Seed
SEED_DEFAULT_PASSWORD=password123
